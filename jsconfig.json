{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strictNullChecks": true,
    "strictFunctionTypes": true,
  },
  "include": [
    "src/**/*.js",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "backup",
    "_backup"
  ]
}